@model VirtualMuseum.Web.Models.ViewModels.ArtistMovementRelationsViewModel

@{
    ViewData["Title"] = "Manage Artist Movements";
}

<h1>Manage Artist Movements</h1>

<div class="mb-4">
    <h4>@Model.ArtistFullName</h4>
    <p>
        <strong>Nationality:</strong> @Model.Nationality
    </p>
</div>

<form asp-action="ManageMovements" method="post">
    <input asp-for="ArtistId" type="hidden" />
    <input asp-for="ArtistFullName" type="hidden" />
    <input asp-for="Nationality" type="hidden" />

    <div class="border rounded p-3" style="max-height: 500px; overflow-y: auto;">
        @for (int i = 0; i < Model.Movements.Count; i++)
        {
            <div class="form-check mb-2">
                <input asp-for="Movements[i].Selected" class="form-check-input" />
                <input asp-for="Movements[i].Id" type="hidden" />
                <input asp-for="Movements[i].Label" type="hidden" />
                <label class="form-check-label" asp-for="Movements[i].Selected">
                    @Model.Movements[i].Label
                </label>
            </div>
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Movements</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>
