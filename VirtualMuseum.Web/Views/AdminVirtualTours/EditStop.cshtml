@model VirtualMuseum.Web.Models.ViewModels.VirtualTourStopFormViewModel

@{
    ViewData["Title"] = "Edit Route Stop";
}

<h1>Edit Route Stop</h1>

<div class="mb-3">
    <h4>@Model.PlanTitle</h4>
    <p><strong>Exhibition:</strong> @Model.ExhibitionTitle</p>
</div>

<form asp-action="EditStop" method="post">
    <input asp-for="StopId" type="hidden" />
    <input asp-for="PlanId" type="hidden" />
    <input asp-for="PlanTitle" type="hidden" />
    <input asp-for="ExhibitionTitle" type="hidden" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="StepNo" class="form-label"></label>
            <input asp-for="StepNo" class="form-control" />
            <span asp-validation-for="StepNo" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="RoomId" class="form-label"></label>
            <input asp-for="RoomId" class="form-control" />
            <span asp-validation-for="RoomId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="EstimatedMinutes" class="form-label"></label>
            <input asp-for="EstimatedMinutes" class="form-control" />
            <span asp-validation-for="EstimatedMinutes" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="RoomName" class="form-label"></label>
        <input asp-for="RoomName" class="form-control" />
        <span asp-validation-for="RoomName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StopTitle" class="form-label"></label>
        <input asp-for="StopTitle" class="form-control" />
        <span asp-validation-for="StopTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update Stop</button>
    <a asp-action="ManageStops" asp-route-id="@Model.PlanId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
