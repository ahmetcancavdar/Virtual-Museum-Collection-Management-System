@model IEnumerable<VirtualMuseum.Web.Models.ViewModels.TourListItemViewModel>

@{
    ViewData["Title"] = "Tour Management";
}

<h1>Tour Management</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    <a asp-controller="AdminTours" asp-action="Create" class="btn btn-primary">Add New Tour</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Exhibition</th>
            <th>Date</th>
            <th>Time</th>
            <th>Language</th>
            <th>Guide</th>
            <th>Capacity</th>
            <th>Status</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.ExhibitionTitle</td>
                <td>@item.TourDate</td>
                <td>@item.StartTime - @item.EndTime</td>
                <td>@item.Language</td>
                <td>@item.GuideName</td>
                <td>@item.Capacity</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TourId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.TourId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
