@model VirtualMuseum.Web.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<p class="text-muted">Central overview of museum data, visit activity, tour activity, and quick management actions.</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold">@Model.TotalArtists</h2>
                <p class="mb-0">Artists</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold">@Model.TotalArtworks</h2>
                <p class="mb-0">Artworks</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold">@Model.TotalExhibitions</h2>
                <p class="mb-0">Exhibitions</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2 class="fw-bold">@Model.TotalTours</h2>
                <p class="mb-0">Tours</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Today's Visits</h5>
                <h2 class="fw-bold">@Model.TodayVisitCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h5 class="card-title">Planned Visits</h5>
                <h2 class="fw-bold">@Model.PlannedVisitCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body">
                <h5 class="card-title">Completed Visits</h5>
                <h2 class="fw-bold">@Model.CompletedVisitCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger h-100">
            <div class="card-body">
                <h5 class="card-title">Cancelled Visits</h5>
                <h2 class="fw-bold">@Model.CancelledVisitCount</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Open Tours</h5>
                <h2 class="fw-bold">@Model.OpenTourCount</h2>
                <p class="text-muted mb-0">Tours currently open for booking</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Upcoming Tours</h5>
                <h2 class="fw-bold">@Model.UpcomingTourCount</h2>
                <p class="text-muted mb-0">Tours scheduled for today or later</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Tour Bookings</h5>
                <h2 class="fw-bold">@Model.TotalTourBookingCount</h2>
                <p class="text-muted mb-0">Total booking records in the system</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <h3 class="mb-3">Quick Management</h3>

    <div class="list-group" style="max-width: 480px;">
        <a asp-controller="AdminArtists" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Artists
        </a>
        <a asp-controller="AdminArtMovements" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Art Movements
        </a>
        <a asp-controller="AdminArtworks" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Artworks
        </a>
        <a asp-controller="AdminExhibitions" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Exhibitions
        </a>
        <a asp-controller="AdminTours" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Tours
        </a>
        <a asp-controller="AdminVisits" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Visits
        </a>
        <a asp-controller="AdminTourBookings" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Tour Bookings
        </a>
        <a asp-controller="AdminVirtualTours" asp-action="Index" class="list-group-item list-group-item-action">
            Manage Virtual Tour Plans
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <h3 class="mb-3">Recent Visits</h3>

        @if (Model.RecentVisits.Any())
        {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Visitor</th>
                        <th>Exhibition</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentVisits)
                    {
                        <tr>
                            <td>@item.VisitorName</td>
                            <td>@item.ExhibitionTitle</td>
                            <td>@item.VisitDate</td>
                            <td>@item.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No visit records found.</p>
        }
    </div>

    <div class="col-md-6">
        <h3 class="mb-3">Recent Tour Bookings</h3>

        @if (Model.RecentTourBookings.Any())
        {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Visitor</th>
                        <th>Tour</th>
                        <th>Exhibition</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentTourBookings)
                    {
                        <tr>
                            <td>@item.VisitorName</td>
                            <td>@item.TourTitle</td>
                            <td>@item.ExhibitionTitle</td>
                            <td>@item.TourDate</td>
                            <td>@item.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No tour booking records found.</p>
        }
    </div>
</div>
