@model VirtualMuseum.Web.Models.ViewModels.ExhibitionDeleteViewModel

@{
    ViewData["Title"] = "Delete Exhibition";
}

<h1>Delete Exhibition</h1>

<div class="alert alert-danger">
    <strong>Warning:</strong> If you delete this exhibition, related FEATURES, CURATED_BY and VISIT records will also be deleted.
</div>

<table class="table table-bordered">
    <tr>
        <th>Title</th>
        <td>@Model.Title</td>
    </tr>
    <tr>
        <th>Theme</th>
        <td>@Model.Theme</td>
    </tr>
    <tr>
        <th>Start Date</th>
        <td>@Model.StartDate</td>
    </tr>
    <tr>
        <th>End Date</th>
        <td>@Model.EndDate</td>
    </tr>
    <tr>
        <th>Room</th>
        <td>@Model.RoomName (@Model.RoomId)</td>
    </tr>
    <tr>
        <th>Active</th>
        <td>@(Model.IsActive ? "Yes" : "No")</td>
    </tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ExhibitionId" />
    <button type="submit" class="btn btn-danger">Yes, Delete Exhibition</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
